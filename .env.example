NEXT_PUBLIC_SITE_URL=https://crazy-good-designs-merch-agent.vercel.app

# Server-only OpenAI configuration. Never use a NEXT_PUBLIC_ prefix for the key.
OPENAI_API_KEY=
MERCH_AGENT_AI_MODE=hybrid
MERCH_AGENT_AI_MODEL_LUNA=gpt-5.6-luna
MERCH_AGENT_AI_MODEL_TERRA=gpt-5.6-terra
MERCH_AGENT_AI_TERRA_ENABLED=false
MERCH_AGENT_AI_WARNING_USD=5
MERCH_AGENT_AI_WARNING_HIGH_USD=8
MERCH_AGENT_AI_MONTHLY_LIMIT_USD=10
MERCH_AGENT_AI_DAILY_REQUEST_LIMIT=100
MERCH_AGENT_AI_MAX_INPUT_TOKENS=12000
MERCH_AGENT_AI_MAX_OUTPUT_TOKENS=1200
